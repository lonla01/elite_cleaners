# Copy to .env.local for development. In Railway, set these per environment
# (staging / production). Never commit real values.

# --- App ---
# development | staging | production. Use "staging" on Railway staging to keep internal
# pages (e.g. /en/styleguide) reachable and to stay out of search engines.
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Railway Postgres: reference ${{Postgres.DATABASE_URL}}) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/elite_cleaners

# --- Auth (milestone 6) ---
# Generate with: openssl rand -base64 48
AUTH_SECRET=
# Used once by the seed script to create the first owner account.
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Email (milestone 5) ---
# resend | smtp | log  ("log" prints emails to the console, for development)
EMAIL_PROVIDER=log
EMAIL_FROM="[Company Name] <noreply@[DOMAIN]>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- File storage: Railway bucket, S3-compatible (milestone 4+) ---
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Analytics (loaded only after cookie consent) ---
# none | plausible
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
